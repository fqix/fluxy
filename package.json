{
  "name": "fluxy",
  "version": "0.3.0",
  "description": "Fluxy network inspector — Electron and TypeScript desktop",
  "private": true,
  "license": "MIT",
  "author": "Fluxy contributors; based on Rockxy",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run core:build && npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "format": "prettier --write src tests electron.vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json package.json tools/whistle",
    "format:check": "prettier --check src tests electron.vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json package.json tools/whistle",
    "test:packaged": "FLUXY_TEST_EXECUTABLE=\"$PWD/dist/mac-arm64/Fluxy.app/Contents/MacOS/Fluxy\" playwright test",
    "core:build": "node build-electron-core.mjs && node build-electron-helper.mjs && npm run whistle:build",
    "predev": "npm run core:build",
    "pretest": "npm run core:build",
    "whistle:build": "node tools/whistle/build.mjs",
    "test:protocol": "npm run whistle:build && tsx tests/protocol/verify.ts",
    "test:protocol:public": "npm run whistle:build && tsx tests/protocol/public.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@peculiar/x509": "^2.1.0",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.9",
    "node-forge": "^1.3.1",
    "protobufjs": "^8.8.0",
    "proxy-agent": "^8.0.2",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.21.3",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.7.0",
    "@grpc/grpc-js": "^1.14.4",
    "@playwright/test": "^1.58.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.2.0",
    "electron-builder": "^26.8.0",
    "electron-vite": "5.0.0",
    "esbuild": "^0.27.3",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.577.0",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "dev.fengqi.fluxy.electron",
    "productName": "Fluxy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "LICENSE",
      "COPYRIGHT.md",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.map",
      {
        "from": "node_modules/react",
        "to": "licenses/react",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/react-dom",
        "to": "licenses/react-dom",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/lucide-react",
        "to": "licenses/lucide-react",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/scheduler",
        "to": "licenses/scheduler",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/class-variance-authority",
        "to": "licenses/class-variance-authority",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/clsx",
        "to": "licenses/clsx",
        "filter": [
          "license"
        ]
      },
      {
        "from": "node_modules/tailwind-merge",
        "to": "licenses/tailwind-merge",
        "filter": [
          "LICENSE.md"
        ]
      },
      {
        "from": "node_modules/@radix-ui/react-slot",
        "to": "licenses/@radix-ui/react-slot",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/@radix-ui/react-compose-refs",
        "to": "licenses/@radix-ui/react-compose-refs",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/tailwindcss",
        "to": "licenses/tailwindcss",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/tw-animate-css",
        "to": "licenses/tw-animate-css",
        "filter": [
          "LICENSE"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "sign": "tools/sign-electron.cjs",
      "extraResources": [
        {
          "from": "build/electron-core",
          "to": "core",
          "filter": [
            "fluxy-core",
            "fluxy-core.build.json",
            "fluxy-core.licenses.txt"
          ]
        },
        {
          "from": "build/electron-helper",
          "to": "helper",
          "filter": [
            "fluxy-helper",
            "fluxy-helper.json",
            "fluxy-helper.licenses.txt"
          ]
        },
        {
          "from": "build/whistle",
          "to": "whistle",
          "filter": [
            "**/*",
            "!upstream/.git",
            "!upstream/test/**/*",
            "!upstream/docs/**/*",
            "!upstream/.github/**/*",
            "!upstream/biz/webui/htdocs/src/**/*"
          ]
        },
        {
          "from": "build/whistle/node_modules",
          "to": "whistle/node_modules",
          "filter": [
            "**/*"
          ]
        }
      ],
      "electronLanguages": [
        "en",
        "zh_CN"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "build/electron-core",
          "to": "core",
          "filter": [
            "fluxy-core.exe",
            "fluxy-core.exe.build.json",
            "fluxy-core.exe.licenses.txt"
          ]
        },
        {
          "from": "build/electron-helper",
          "to": "helper",
          "filter": [
            "fluxy-helper.exe",
            "fluxy-helper.exe.json",
            "fluxy-helper.licenses.txt"
          ]
        },
        {
          "from": "build/whistle",
          "to": "whistle",
          "filter": [
            "**/*",
            "!upstream/.git",
            "!upstream/test/**/*",
            "!upstream/docs/**/*",
            "!upstream/.github/**/*",
            "!upstream/biz/webui/htdocs/src/**/*"
          ]
        },
        {
          "from": "build/whistle/node_modules",
          "to": "whistle/node_modules",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "deb",
        "rpm"
      ],
      "extraResources": [
        {
          "from": "build/electron-core",
          "to": "core",
          "filter": [
            "fluxy-core",
            "fluxy-core.build.json",
            "fluxy-core.licenses.txt"
          ]
        },
        {
          "from": "build/electron-helper",
          "to": "helper",
          "filter": [
            "fluxy-helper",
            "fluxy-helper.json",
            "fluxy-helper.licenses.txt"
          ]
        },
        {
          "from": "build/whistle",
          "to": "whistle",
          "filter": [
            "**/*",
            "!upstream/.git",
            "!upstream/test/**/*",
            "!upstream/docs/**/*",
            "!upstream/.github/**/*",
            "!upstream/biz/webui/htdocs/src/**/*"
          ]
        },
        {
          "from": "build/whistle/node_modules",
          "to": "whistle/node_modules",
          "filter": [
            "**/*"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Fluxy contributors",
      "synopsis": "HTTP and HTTPS network inspector"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/fqix/fluxy/releases/latest/download/",
        "channel": "latest-${arch}"
      }
    ],
    "artifactName": "Fluxy-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "dmg": {
      "format": "UDBZ"
    }
  },
  "homepage": "https://github.com/fqix/fluxy"
}
